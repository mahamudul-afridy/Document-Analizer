# Copy to .env:  cp .env.example .env
# The defaults work as-is on a local PC. On a VPS, change the values marked (VPS).

# Web address. Empty = http://localhost.
# (VPS) set your domain for automatic HTTPS, e.g. SITE_ADDRESS=documind.example.com
SITE_ADDRESS=
HTTP_PORT=80
HTTPS_PORT=443

# (VPS) APP_ENV=production
APP_ENV=development
# (VPS) generate with: openssl rand -hex 32   (the app refuses to start in production with the default)
SECRET_KEY=change-me-to-a-long-random-string

POSTGRES_USER=documind
# (VPS) generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me
POSTGRES_DB=documind

# Number of documents processed in parallel
WORKER_CONCURRENCY=2
MAX_UPLOAD_MB=25

# Money tolerance for arithmetic checks, tax tolerance (%), and the review threshold for low-confidence fields
VALIDATION_TOLERANCE=0.01
TAX_TOLERANCE_PCT=0.5
LOW_CONFIDENCE_THRESHOLD=0.75

# No AI API key is needed. An optional LLM (Anthropic/OpenAI) can be enabled later in
# Settings -> AI Engine inside the app; the key is stored encrypted in the database.
